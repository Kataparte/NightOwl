#!/bin/bash
# 0. Ensure cache exists
mkdir -p "$HOME/.cache/awww"

# 1. Start the daemon if it's missing (Detached)
if ! pgrep -x "awww-daemon" > /dev/null; then
    (awww-daemon > /dev/null 2>&1 &)
    disown
    sleep 1.2
fi

# 2. Change wallpaper
awww img "$1"

# 3. Generate colors
matugen image "$1"

# 4. Reload Hyprland
hyprctl reload
