#!/usr/bin/env bash

OPTIONS="Lock\nLogout\nSuspend\nReboot\nShutdown"

CHOICE=$(echo -e "$OPTIONS" | rofi -dmenu -p "Power")

case "$CHOICE" in
  Lock)     hyprlock ;;
  Logout)   hyprctl dispatch exit ;;
  Suspend)  systemctl suspend ;;
  Reboot)   systemctl reboot ;;
  Shutdown) systemctl poweroff ;;
esac
